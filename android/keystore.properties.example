# Copia este archivo como android/keystore.properties y completa los valores.
# android/keystore.properties está en .gitignore: NO lo subas al repositorio.
# El keystore (.jks) debe vivir FUERA del repositorio.
#
# Alternativa para CI (GitHub Actions, job release-aab): el workflow decodifica el secret
# CMP_RELEASE_KEYSTORE_BASE64 a un .jks temporal y define las variables de entorno
# CMP_RELEASE_STORE_FILE, CMP_RELEASE_STORE_PASSWORD, CMP_RELEASE_KEY_ALIAS y
# CMP_RELEASE_KEY_PASSWORD.

# Ruta absoluta al keystore. En Windows usa barras normales o \\ dobles.
storeFile=
storePassword=
keyAlias=
keyPassword=
